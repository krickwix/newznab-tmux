                            72
                        ]
                    ],
                    "\\CaptainHook\\App\\Hook\\Message\\Rule\\SeparateSubjectFromBodyWithBlankLine",
                    "\\CaptainHook\\App\\Hook\\Message\\Rule\\MsgNotEmpty"
                ],
                "conditions": []
            }
        ]
    },
    "pre-push": {
        "enabled": false,
        "actions": []
