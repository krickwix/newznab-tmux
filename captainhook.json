                            200
                        ]
                    ],
                    "\\CaptainHook\\App\\Hook\\Message\\Rule\\NoPeriodOnSubjectEnd",
                    [
                        "\\CaptainHook\\App\\Hook\\Message\\Rule\\LimitBodyLineLength",
